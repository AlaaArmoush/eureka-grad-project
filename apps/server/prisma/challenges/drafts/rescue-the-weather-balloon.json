  "explanations": {
    "success": {
      "title": "Beacon lit",
      "message": "The capsule landed {landingDistance} from the rail after {flightTime} in the air, inside the beacon."
    },
    "borderline": {
      "title": "Too close to call",
      "message": "The capsule landed {landingDistance} from the rail after {flightTime}, which is too close to the edge for the measurement uncertainty to decide. It waits for an authoritative check and does not count as a hit or a miss."
    },
    "invalid": {
      "engineFailure": {
        "title": "The run stopped",
        "message": "The physics run reported a problem, so this attempt cannot be judged. Reset and launch again."
      },
      "nonFiniteValue": {
        "title": "Unusable measurement",
        "message": "A measured value was not a finite number, so this attempt cannot be judged. Reset and launch again."
      },
      "incompleteRun": {
        "title": "The run did not finish",
        "message": "The capsule never touched down before the run limit, so there is nothing to judge. Reset and launch again."
      },
      "forbiddenEdit": {
        "title": "A locked value changed",
        "message": "This challenge fixes some values. Reset restores them, and then you can launch again."
      }
    },
    "misses": [
      {
        "id": "short-and-low",
        "title": "Short and too flat",
        "message": "The capsule landed {landingDistance} from the rail, {range.gap} short of the beacon. A flat arc is gone before it has travelled far: raise the angle.",
        "when": [
          {
            "kind": "criterion",
            "criterionId": "range",
            "side": "below"
          },
          {
            "kind": "measurement",
            "measurementId": "apexHeight",
            "side": "below",
            "threshold": 10
          }
        ]
      },
      {
        "id": "short-and-high",
        "title": "Short and too steep",
        "message": "The capsule climbed {apexHeight} but landed {range.gap} short of the beacon ({landingDistance}). A steep launch spends its speed going up instead of forward: lower the angle.",
        "when": [
          {
            "kind": "criterion",
            "criterionId": "range",
            "side": "below"
          },
          {
            "kind": "measurement",
            "measurementId": "apexHeight",
            "side": "above",
            "threshold": 10
          }
        ]
      },
      {
        "id": "long",
        "title": "Too long",
        "message": "The capsule landed {landingDistance} from the rail, {range.gap} past the beacon. At this speed the range is greatest at 45°, so move the angle away from 45°.",
        "when": [
          {
            "kind": "criterion",
            "criterionId": "range",
            "side": "above"
          }
        ]
      }
    ],
    "fallbackMiss": {
      "title": "Missed the beacon",
      "message": "The capsule landed {landingDistance} from the rail after {flightTime}, outside what the beacon accepts."
    }
  },
  "hints": [
    {
      "text": "The marker shows how high your current launch climbs. A launch that reaches the beacon distance is neither very flat nor very steep.",
      "reveal": "apexMarker"
    },
    {
      "text": "At a fixed speed the range is R = v²·sin(2θ)/g. Two angles that add up to 90° land in the same place.",
      "reveal": null
    }
  ],
